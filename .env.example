# URL pública (sense barra final)
NEXT_PUBLIC_APP_URL=https://apte.cat

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Preus (pagament únic, IVA inclòs)
STRIPE_PRICE_PACK5=price_...
STRIPE_PRICE_PASS30=price_...
# Webhook → /api/stripe/webhook (event checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Dades del titular per a /legal (LSSI/RGPD)
LEGAL_NAME=Nom Cognom Cognom
LEGAL_NIF=12345678A
LEGAL_ADDRESS=Carrer Exemple 1, 08000 Barcelona

# Google Search Console → codi de verificació (opcional)
GOOGLE_SITE_VERIFICATION=

# Google Ads (opcional). Sense ID no es carrega res ni surt l'avís de galetes.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
