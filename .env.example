# URL pública de l'app (sense barra final). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://senyal.cat

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Preu de la subscripció (Products → Senyal Pro → price_...)
STRIPE_PRICE_ID=price_...
# Taxa d'IVA del 21% (Product catalog → Tax rates → txr_...). Opcional però recomanat.
STRIPE_TAX_RATE_ID=txr_...
# Webhook "Your account" (subscripcions)
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook "Connected accounts" (paga i senyal dels negocis)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Resend (correus). Sense clau, els correus només es mostren al log.
RESEND_API_KEY=re_...
EMAIL_FROM=Senyal <hola@senyal.cat>

# Secret per protegir el cron de recordatoris (qualsevol cadena llarga)
CRON_SECRET=canvia-aixo-per-una-cadena-llarga

# Dades del titular per a la pàgina /legal (obligatori LSSI/RGPD)
LEGAL_NAME=Nom Cognom Cognom
LEGAL_NIF=12345678A
LEGAL_ADDRESS=Carrer Exemple 1, 08000 Barcelona
