# URL pública definitiva (sense barra final)
NEXT_PUBLIC_SITE_URL=https://calculaya.com
# Només si la web viu en una subcarpeta (p. ex. GitHub Pages de projecte: /demana-hora)
NEXT_PUBLIC_BASE_PATH=
# Correu de contacte (per defecte hola@ + domini)
NEXT_PUBLIC_CONTACT_EMAIL=
# Google AdSense (ca-pub-XXXXXXXXXXXXXXXX). Buit = sense anuncis.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Dades del titular per a l'avís legal (obligatori per a AdSense i LSSI)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_NIF=
